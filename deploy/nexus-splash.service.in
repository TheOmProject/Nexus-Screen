# Nexus Screen boot splash — optional, installed separately with deploy/splash.sh.
# This is a template. deploy/splash.sh generates the real unit from this file.
# Placeholders: @USER@ @HOME@ @REPO@
[Unit]
Description=Nexus Screen boot splash
Documentation=https://github.com/omarmunoz5371/Nexus-Screen
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
# Start before Nexus Screen; Nexus Screen waits for the handover signal
Before=nexus-screen.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=!@HOME@/nexus-splash/DISABLED
ConditionPathExists=@HOME@/nexus-splash/build/still.rgb565

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=video tty
# CAP_SYS_TTY_CONFIG is needed to set the console graphics mode on tty7
AmbientCapabilities=CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
NoNewPrivileges=yes
WorkingDirectory=@REPO@
RuntimeDirectory=nexus-splash
RuntimeDirectoryMode=0755
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/bin/python3 @REPO@/splash/player.py
# Restore the text console if Nexus Screen is not running after the splash exits
ExecStopPost=+/bin/sh -c 'systemctl -q is-active nexus-screen || chvt 1'
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=200M
RuntimeMaxSec=120
TimeoutStopSec=5
Restart=no

[Install]
WantedBy=sysinit.target
