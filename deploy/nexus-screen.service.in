# Nexus Screen — permanent touchscreen interface.
# This is a template. deploy/install.sh generates the real unit from this file.
# Placeholders: @USER@ @HOME@ @REPO@
[Unit]
Description=Nexus Screen (PyQt6 touchscreen interface)
Documentation=https://github.com/omarmunoz5371/Nexus-Screen
After=moonraker.service systemd-user-sessions.service
Wants=moonraker.service
# Never run two display clients at the same time
Conflicts=KlipperScreen.service
ConditionPathExists=/dev/fb0
# Crash-loop guard: after 5 failures within 2 minutes systemd stops retrying
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=video input tty render
WorkingDirectory=@REPO@
# Own the virtual terminal so Qt can switch to graphics mode (no text or cursor visible)
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
ExecStartPre=+/usr/bin/chvt 7
ExecStartPre=@REPO@/deploy/precheck.sh
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0:tty=/dev/tty
Environment=QT_QPA_FB_HIDECURSOR=1
Environment=PYTHONUNBUFFERED=1
# Live Moonraker data; printer commands stay disabled until authorized with deploy/commands.sh
ExecStart=@HOME@/nexus-screen-env/bin/python @REPO@/main.py --hardware-display --live
KillSignal=SIGTERM
TimeoutStopSec=10
# Restore the text console whenever Nexus Screen stops
ExecStopPost=+/usr/bin/chvt 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
